# Conflict: Middle East Political Simulator - Environment Configuration

# AI Provider (claude | openai | mock)
# Use 'mock' for development without API access
VITE_AI_PROVIDER=mock

# Anthropic API Key (if using Claude)
VITE_ANTHROPIC_API_KEY=

# OpenAI API Key (if using OpenAI)
VITE_OPENAI_API_KEY=

# AI Model Override (optional)
# Default: claude-3-5-sonnet-20241022
VITE_AI_MODEL=

# Debug Mode (shows additional logging)
VITE_DEBUG=false
